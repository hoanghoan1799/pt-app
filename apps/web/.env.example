# SQLite file locally; a libsql:// URL (Turso) when deployed.
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Super admin: used by `pnpm db:setup` (first admin) and `pnpm admin:create`;
# the app itself stores admins (hashed) in the database.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-me-min-8-chars
# Old names, still read when SUPER_ADMIN_* are missing:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-min-8-chars
# Base URL of the NestJS API the web server calls (server only). Local: start it
# with `docker compose up -d --build db api` (see CLAUDE.md). Required in production.
API_URL=http://localhost:4000
# No longer used for sessions (they are opaque API tokens now); removed with the
# JWT code in step 10.
# SESSION_SECRET=

# Optional: lets /api/health?token=… show configuration details in production
# (at least 16 characters). Without it, production only reports ok/error.
# HEALTH_CHECK_TOKEN=

# The address of the API the BROWSER connects to for realtime chat (Socket.IO).
# Everything else goes through this app. Local default: http://localhost:4000.
# Unset in production = chat polls only. The API must allow this web origin
# (its WEB_ORIGIN). Read on the server and sent with the realtime ticket.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional, Web Push of the social notifications still sent from this app (chat
# push is the API's: GET /v1/push/config gives the browser its public key). Generate the pair with
# `pnpm dlx web-push generate-vapid-keys`; subject is a mailto: or https: URL.
# Push is skipped when any of them is empty. The public key is also read from
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (browser-visible by design); the private key never.
# VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
