    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "openapi-typescript": "^7.13.0",
    "pg": "8.23.1",
