{
  "name": "@pt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm test && pnpm test:e2e && pnpm lint && pnpm typecheck",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typeorm": "node --env-file-if-exists=.env --import tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d src/data-source.ts -p",
    "migration:run": "pnpm typeorm migration:run -d src/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/data-source.ts",
    "migration:check": "pnpm typeorm migration:generate -d src/data-source.ts --check src/migrations/CheckPending",
    "migrate": "node dist/migrate.js",
    "openapi": "tsc -p tsconfig.build.json && node dist/openapi/write.js",
    "foods:seed": "node --env-file-if-exists=.env --import tsx src/scripts/seed-foods.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx src/scripts/create-admin.ts",
    "data:columns": "tsx scripts/generate-turso-columns.ts",
    "data:migrate": "tsx scripts/migrate-from-turso.ts",
    "data:verify": "tsx scripts/migrate-from-turso.ts --verify"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/event-emitter": "12.0.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.3",
    "@pt/contracts": "workspace:*",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "1.1.2",
    "typeorm-naming-strategies": "4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "eslint": "^9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "pino-pretty": "13.2.0",
    "supertest": "^7.3.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
