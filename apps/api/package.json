{
  "name": "@pt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm test && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@pt/contracts": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "supertest": "^7.3.2",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
