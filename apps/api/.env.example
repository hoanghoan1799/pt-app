# Local development only. Copy to apps/api/.env (git-ignored) and adjust.
# The values match docker-compose.yml: `docker compose up -d db` publishes
# PostgreSQL on localhost:5432. Never put production credentials here.

# Required. PostgreSQL connection URL.
DATABASE_URL=postgres://pt:pt_local_only@localhost:5432/ptapp

# Optional (defaults in parentheses).
NODE_ENV=development            # development | test | production (production when unset)
# PORT=4000
# WEB_ORIGIN=http://localhost:3000
# LOGIN_THROTTLE_LIMIT=20       # requests per minute and IP on login / passcode routes
# LOG_LEVEL=info                # fatal|error|warn|info|debug|trace|silent; (warn in production)
# GIPHY_API_KEY=                # sticker search; the GIPHY tab is off without it
# VAPID_PUBLIC_KEY=             # web push; all three needed, push is off without them
# VAPID_PRIVATE_KEY=            # generate: npx web-push generate-vapid-keys
# VAPID_SUBJECT=mailto:you@example.com
# REALTIME_RECHECK_SECONDS=300  # how often open sockets re-check their session
