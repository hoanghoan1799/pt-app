{
  "name": "pt-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:contracts": "pnpm --filter @pt/contracts build",
    "dev": "pnpm build:contracts && pnpm --filter @pt/web dev",
    "dev:api": "pnpm build:contracts && pnpm --filter @pt/api dev",
    "dev:db": "docker compose up -d --build db api",
    "dev:all": "pnpm dev:db && pnpm dev",
    "build": "pnpm build:contracts && pnpm --filter @pt/web build",
    "start": "pnpm --filter @pt/web start",
    "lint": "pnpm build:contracts && pnpm -r --no-bail lint",
    "typecheck": "pnpm build:contracts && pnpm -r --no-bail typecheck",
    "test": "pnpm build:contracts && pnpm -r --no-bail test && pnpm test:tools",
    "test:tools": "node --test .claude/hooks/pair/__tests__/hooks.test.mjs && vitest run --config vitest.config.mjs",
    "test:e2e": "pnpm build:contracts && pnpm --filter @pt/web test:e2e",
    "format": "prettier --write .",
    "verify": "pnpm build:contracts && pnpm -r --no-bail verify && pnpm test:tools",
    "db:migrate": "pnpm --filter @pt/api migration:run",
    "db:seed-foods": "pnpm --filter @pt/api foods:seed",
    "db:seed-demo": "pnpm --filter @pt/api demo:seed",
    "admin:create": "pnpm --filter @pt/api admin:create",
    "pwa:icons": "pnpm --filter @pt/web pwa:icons"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "vitest": "^4.1.11"
  }
}
