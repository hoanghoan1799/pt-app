# SQLite file locally; a libsql:// URL (Turso) when deployed.
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Only read by `npm run admin:create` to create/reset an admin account;
# the app itself stores admins (hashed) in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
# Secret used to sign session cookies (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
