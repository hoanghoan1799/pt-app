# SQLite file locally; a libsql:// URL (Turso) when deployed.
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Only read by `npm run admin:create` to create/reset an admin account;
# the app itself stores admins (hashed) in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
# Secret used to sign session cookies (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional: lets /api/health?token=… show configuration details in production
# (at least 16 characters). Without it, production only reports ok/error.
# HEALTH_CHECK_TOKEN=

# Optional, server-only (never NEXT_PUBLIC_): Ably API key restricted to chat:*.
# Without it chat uses polling only.
# ABLY_API_KEY=

# Optional, Web Push for new chat messages. Generate the pair with
# `pnpm dlx web-push generate-vapid-keys`; subject is a mailto: or https: URL.
# Push is skipped when any of them is empty. The public key is also read from
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (browser-visible by design); the private key never.
# VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
