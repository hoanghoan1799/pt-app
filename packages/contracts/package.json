{
  "name": "@pt/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free Zod schemas, limits and pure helpers shared by the web app, the API and a future mobile app.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm test && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  }
}
